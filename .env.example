# Twelve Data MCP Server — copy to .env and fill in values.
#
# Only what a local start must supply. A deployment that serves the public internet is
# configured from its own environment rather than from a file in the checkout, so the keys
# that turn this server into a public one are not here.

# Upstream Twelve Data (Passport) OAuth credentials, for the local login flow.
# Register an app at twelvedata.com to get these.
MCP_DATA_TWELVE_DATA_CLIENT_ID=
MCP_DATA_TWELVE_DATA_CLIENT_SECRET=

# Redirect URI for the OAuth login. Leave it unset:
# - stdio and `make run` on localhost use http://localhost:8765/callback;
# - behind ngrok the server derives https://<host>/callback from the request.
# Set it only for a redirect the server cannot see. Use `localhost`, never `127.0.0.1`:
# the server treats any other host as public, and Passport matches `localhost` exactly.
# MCP_DATA_TWELVE_DATA_REDIRECT_URI=

# Passport address for the login; default https://twelvedata.com; set only to test against your own finapi-web.
# MCP_DATA_TWELVE_DATA_OAUTH_BASE=

# Optional: skip logging in and present one static API key instead. It is the last rung of
# the identity resolve and never a fallback at the seam — nothing reaches for it once some
# other credential has resolved.
# TWELVE_DATA_API_KEY=
